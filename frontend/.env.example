# ============================================================
# FIN SMART — FRONTEND ENVIRONMENT VARIABLES
# Salin ke `.env.local` untuk dev, dan isi nilai yang sama di
# Vercel (Settings → Environment Variables) saat deploy frontend.
# Semua variabel MAKSIMAL dimulai dengan NEXT_PUBLIC_ agar bisa
# dibaca di browser (client-side).
# ============================================================

# ── API Backend (WAJIB) ──────────────────────────────────────
# URL backend yang sudah di-deploy (Express).
# Untuk dev lokal: http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Supabase Auth (WAJIB) ────────────────────────────────────
# Ambil dari Supabase → Project Settings → API.
# URL project Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon key (aman ditampilkan ke frontend).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1yZWYiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYx...
# (Opsional referensi) Nama ref project Supabase — tidak dipakai langsung di kode.
# NEXT_PUBLIC_SUPABASE_REF=YOUR-PROJECT-REF

