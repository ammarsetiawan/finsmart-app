# ============================================================
# FIN SMART — BACKEND ENVIRONMENT VARIABLES
# Salin file ini menjadi `.env` untuk pengembangan lokal,
# dan isi nilai yang sama di dashboard Vercel (Settings → Environment Variables)
# saat deploy backend.
# ============================================================

# ── Database (WAJIB) ──────────────────────────────────────────
# Koneksi Supabase Postgres. Ini penyebab error FUNCTION_INVOCATION_FAILED
# jika kosong. Ambil dari Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── Supabase Auth (WAJIB) ─────────────────────────────────────
# Ambil dari Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1yZWYiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYx...
# Service-role key (RAHASIA — hanya untuk backend, JANGAN pernah ke frontend).
# Wajib jika memakai halaman admin / daftar akun pengguna.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1yZWYiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjE...

# ── Admin (opsional, ada default) ────────────────────────────
# Daftar email admin, dipisah koma. Default: ammarsetiawan970@gmail.com
ADMIN_EMAILS=ammarsetiawan970@gmail.com

# ── CORS (WAJIB untuk produksi) ───────────────────────────────
# URL frontend produksi. Otomatis ditambahkan ke allowed origins.
FRONTEND_URL=https://finsmart.vercel.app
# Daftar origin tambahan yang diizinkan CORS, dipisah koma.
ALLOWED_ORIGINS=https://finsmart.vercel.app

# ── Server (opsional, otomatis di Vercel) ─────────────────────
# NODE_ENV otomatis 'production' di Vercel → app.listen dilewati.
# PORT default 5000 (di Vercel ditangani otomatis, tidak perlu diisi).
PORT=5000

# ── Dev only (JANGAN di-set di produksi) ──────────────────────
# Hanya untuk bypass auth saat pengembangan lokal.
# LOCAL_DEV_AUTH_BYPASS=true

